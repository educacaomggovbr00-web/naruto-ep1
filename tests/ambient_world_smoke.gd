extends SceneTree

func _initialize() -> void: call_deferred("checks")
func close_dialogue(game:Node) -> void:
	while not game.lines.is_empty(): game.next_line()

func checks() -> void:
	var game=load("res://scenes/main.tscn").instantiate()
	game.savegame.enabled=false
	root.add_child(game)
	await process_frame
	game.audio.set_enabled(false)
	close_dialogue(game)
	game._process(0)
	game.player=Vector2(92,238)
	assert(not game.blocked(game.player),"Interactive branch must be reachable")
	game.act("interact")
	assert(game.ambient.particles.size()==18 and game.ambient.shake_life>0)
	game.act("interact")
	assert(game.ambient.particles.size()==18,"Repeated taps must not multiply effects")
	game.ui.journal.toggle()
	var life:float=game.ambient.shake_life
	game._process(3)
	assert(game.ambient.shake_life==life,"Menu pauses world reactions")
	game.ui.journal.close()
	game._process(3)
	assert(game.ambient.particles.is_empty())
	game.stage=2
	game._process(0)
	game.player=Vector2(471,309)
	assert(not game.blocked(game.player),"Water interaction must be reachable on dry land")
	game.act("interact")
	assert(game.ambient.ripples.size()==3 and game.stage==2 and game.lines.is_empty())
	game._process(2)
	game.player=Vector2(255,342)
	assert(not game.blocked(game.player),"Bench interaction must be reachable")
	game.stamina=12
	game.act("interact")
	assert(game.stamina==100 and game.stage==2)
	game.player=Vector2(495,285)
	game._process(0)
	assert(game.ambient.reaction("Hiruzen")>0)
	game.act("interact")
	assert(game.lines[0].begins_with("Hiruzen:"),"NPC dialogue has priority over scenery")
	close_dialogue(game)
	game.player=Vector2(560,280)
	game.act("interact")
	assert(game.pending_forest_transition,"Main Naruto conversation must retain priority")
	close_dialogue(game)
	assert(game.stage==3)
	game.player=Vector2(120,240)
	assert(game.ambient.nearby(game).is_empty(),"No optional distraction during the pursuit")
	game.stage=4
	game.target=Vector2(700,280)
	game._process(0)
	assert(not game.ambient.nearby(game).is_empty())
	game.act("interact")
	assert(game.stage==4 and game.ambient.particles.size()==18)
	var save:Dictionary=game.savegame.snapshot(game)
	assert(game.savegame.apply(game,save))
	assert(game.ambient.particles.is_empty() and game.ambient.reactions.is_empty(),"Loads must discard transient effects")
	game.room="academy"
	assert(game.ambient.nearby(game).is_empty())
	game._process(0)
	game.player=Vector2(480,265)
	game._process(0)
	assert(game.ambient.reaction("Iruka")>0)
	game.act("interact")
	assert(game.visited.class_intro and game.lines[0].begins_with("Iruka:"))
	print("PASS: reachable scenery, bounded effects, pause, water, stamina, NPC reactions, interaction priority, protected pursuit and load cleanup")
	game.audio.shutdown()
	game.queue_free()
	await create_timer(0.1).timeout
	quit()
